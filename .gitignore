# FRONTEND (React + Vite)
# ================================

# Dependencias
frontend/node_modules/
frontend/.pnp/
frontend/.pnp.js

# Builds
frontend/dist/
frontend/build/
frontend/.vite/

# Archivos de entorno
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Logs
frontend/*.log
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# Cachés
frontend/.eslintcache
frontend/.cache/

# Cobertura de pruebas
frontend/coverage/
frontend/.nyc_output/

