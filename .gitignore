# ================================
# BACKEND (Python / FastAPI)
# ================================

# Entornos virtuales
venv/
.venv/
env/
.env/
ENV/

# Archivos compilados de Python
__pycache__/
*.py[cod]
*.so
*.pyd

# Archivos de configuración local
.env
.env.local
.env.*.local

# Bases de datos locales
*.db
*.sqlite3

# Logs
logs/
*.log

# Backend - carpetas específicas
backend/venv/
backend/.venv/
backend/__pycache__/
backend/*.pyc
backend/.env
backend/.env.local

# Archivos de migraciones (Alembic)
alembic/versions/*.pyc

# Cobertura de pruebas
.coverage
htmlcov/
.pytest_cache/

